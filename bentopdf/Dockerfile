# BentoPDF (https://github.com/alam00000/bentopdf, AGPL-3.0), versione «simple» per uso interno: nginx non privilegiato sulla
# porta 8080. Tutto il lavoro sui PDF avviene nel browser di chi la usa: il server serve solo la pagina.
ARG BUILD_FROM
FROM $BUILD_FROM
LABEL io.hass.name="BentoPDF" io.hass.type="addon" io.hass.version="2.8.10"
